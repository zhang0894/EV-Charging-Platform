/* =========================================================
 * 充电桩运营管理平台 - 深色夜间 QSS 样式表
 * 配色：深色底（#1a1d23）+ 深灰卡片（#252a33）+ 蓝色主色（#2b7bff）
 * ========================================================= */

/* ---------------- 全局背景与字体 ---------------- */
QWidget {
    background-color: #1a1d23;
    color: #e8ecf0;
    font-family: "-apple-system", "BlinkMacSystemFont", "Segoe UI",
                 "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC",
                 Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
}

/* ---------------- 主窗口 ---------------- */
QMainWindow {
    background-color: #1a1d23;
}

/* ---------------- 侧边栏 ---------------- */
QFrame#sidebarFrame {
    background-color: #20242c;
    border-right: 1px solid #3a4050;
}

/* 侧边栏顶部品牌 LOGO 区 */
QLabel#brandLabel {
    color: #4d9bff;
    font-size: 18px;
    font-weight: 700;
    padding: 20px 20px;
    border-bottom: 1px solid #3a4050;
    background-color: #20242c;
}

/* 侧边栏菜单按钮 */
QPushButton#btnDashboard,
QPushButton#btnPileStatus,
QPushButton#btnPileManage,
QPushButton#btnStationManage,
QPushButton#btnUserManage,
QPushButton#btnOrderManage {
    text-align: left;
    padding: 14px 20px 14px 22px;
    margin: 2px 10px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 6px;
    background-color: transparent;
    color: #a0a8b8;
    font-size: 15px;
}

QPushButton#btnDashboard:hover,
QPushButton#btnPileStatus:hover,
QPushButton#btnPileManage:hover,
QPushButton#btnStationManage:hover,
QPushButton#btnUserManage:hover,
QPushButton#btnOrderManage:hover {
    background-color: #2a3040;
    color: #4d9bff;
}

QPushButton#btnDashboard:checked,
QPushButton#btnPileStatus:checked,
QPushButton#btnPileManage:checked,
QPushButton#btnStationManage:checked,
QPushButton#btnUserManage:checked,
QPushButton#btnOrderManage:checked {
    background-color: #1e3a5f;
    border-left: 3px solid #2b7bff;
    color: #4d9bff;
    font-weight: 600;
}

QPushButton#btnDashboard,
QPushButton#btnPileStatus,
QPushButton#btnPileManage,
QPushButton#btnStationManage,
QPushButton#btnUserManage,
QPushButton#btnOrderManage {
    icon-size: 22px;
}

/* 退出登录按钮 */
QPushButton#btnLogout {
    text-align: left;
    padding: 14px 20px 14px 22px;
    margin: 8px 10px 16px 10px;
    border: none;
    border-radius: 6px;
    background-color: transparent;
    color: #7a8290;
    font-size: 15px;
    icon-size: 22px;
}
QPushButton#btnLogout:hover {
    background-color: #3a2020;
    color: #ef4444;
}

/* 管理员信息 */
QLabel#adminInfoLabel {
    color: #7a8290;
    font-size: 13px;
    padding: 6px 20px;
    background-color: transparent;
    border-top: 1px solid #3a4050;
}

/* 主题切换按钮 */
QPushButton#btnThemeToggle {
    text-align: left;
    padding: 10px 20px;
    margin: 4px 10px;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #a0a8b8;
    font-size: 14px;
    icon-size: 18px;
}
QPushButton#btnThemeToggle:hover {
    background-color: #2a3040;
    color: #4d9bff;
}

/* ---------------- 内容区 Stack ---------------- */
QStackedWidget {
    background-color: #1a1d23;
}

QLabel#placeholderLabel,
QLabel#placeholderLabel_2,
QLabel#placeholderLabel_3,
QLabel#placeholderLabel_4 {
    color: #7a8290;
    font-size: 20px;
    font-weight: 500;
    qproperty-alignment: AlignCenter;
}

/* ---------------- 日志区 ---------------- */
QPlainTextEdit#logEdit {
    background-color: #20242c;
    color: #a0a8b8;
    border-top: 1px solid #3a4050;
    border: none;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    padding: 8px 12px;
}

/* ============== DashboardWidget 销售业绩页 ============== */

QFrame#cardToday, QFrame#cardMonth, QFrame#cardTotal {
    background-color: #252a33;
    border: 1px solid #3a4050;
    border-radius: 10px;
}

QFrame#cardToday:hover, QFrame#cardMonth:hover, QFrame#cardTotal:hover {
    border: 1px solid #2b7bff;
}

QLabel#labelTitleToday, QLabel#labelTitleMonth, QLabel#labelTitleTotal {
    color: #a0a8b8;
    font-size: 14px;
    font-weight: 500;
}

QLabel#labelValueToday, QLabel#labelValueMonth, QLabel#labelValueTotal {
    color: #e8ecf0;
    font-size: 30px;
    font-weight: 700;
}

QLabel#labelSubToday, QLabel#labelSubMonth, QLabel#labelSubTotal {
    color: #7a8290;
    font-size: 12px;
}

QPushButton#btn7Days, QPushButton#btn30Days {
    background-color: #252a33;
    color: #a0a8b8;
    border: 1px solid #3a4050;
    border-radius: 4px;
    padding: 6px 18px;
    min-width: 80px;
}

QPushButton#btn7Days:hover, QPushButton#btn30Days:hover {
    border: 1px solid #2b7bff;
    color: #4d9bff;
}

QPushButton#btn7Days:checked, QPushButton#btn30Days:checked {
    background-color: #2b7bff;
    color: #ffffff;
    border: 1px solid #2b7bff;
    font-weight: 600;
}

QLabel#trendTitle {
    color: #e8ecf0;
    font-size: 16px;
    font-weight: 600;
}

QFrame#chartFrame {
    background-color: #252a33;
    border: 1px solid #3a4050;
    border-radius: 8px;
}

QChartView {
    background-color: #252a33;
    border: none;
}

/* ============== 通用控件 ============== */

QDialog {
    background-color: #252a33;
}

QLineEdit {
    background-color: #2a3040;
    color: #e8ecf0;
    border: 1px solid #3a4050;
    border-radius: 6px;
    padding: 8px 10px;
    selection-background-color: #1e3a5f;
    selection-color: #e8ecf0;
}
QLineEdit:hover {
    border: 1px solid #2b7bff;
}
QLineEdit:focus {
    border: 1px solid #2b7bff;
}
QLineEdit::placeholder {
    color: #7a8290;
}
QLineEdit:disabled {
    background-color: #20242c;
    color: #7a8290;
}

QComboBox {
    background-color: #2a3040;
    color: #e8ecf0;
    border: 1px solid #3a4050;
    border-radius: 6px;
    padding: 6px 10px;
}
QComboBox:hover {
    border: 1px solid #2b7bff;
}
QComboBox:focus {
    border: 1px solid #2b7bff;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox QAbstractItemView {
    background-color: #2a3040;
    color: #e8ecf0;
    border: 1px solid #3a4050;
    border-radius: 6px;
    outline: none;
    selection-background-color: #1e3a5f;
    selection-color: #4d9bff;
}

QPushButton {
    background-color: #2a3040;
    color: #e8ecf0;
    border: 1px solid #3a4050;
    border-radius: 6px;
    padding: 7px 16px;
}
QPushButton:hover {
    border: 1px solid #2b7bff;
    color: #4d9bff;
}
QPushButton:pressed {
    background-color: #1e3a5f;
}
QPushButton:disabled {
    background-color: #20242c;
    color: #7a8290;
    border: 1px solid #3a4050;
}

QPushButton#btnLogin {
    background-color: #2b7bff;
    color: #ffffff;
    border: 1px solid #2b7bff;
    border-radius: 6px;
    padding: 9px 16px;
    font-weight: 600;
}
QPushButton#btnLogin:hover {
    background-color: #1a5cff;
    border: 1px solid #1a5cff;
}
QPushButton#btnLogin:pressed {
    background-color: #1450e0;
}
QPushButton#btnLogin:disabled {
    background-color: #1e3a5f;
    border: 1px solid #1e3a5f;
    color: #a0a8b8;
}

QTableView, QTableWidget {
    background-color: #252a33;
    color: #e8ecf0;
    border: 1px solid #3a4050;
    border-radius: 8px;
    gridline-color: #3a4050;
    selection-background-color: #1e3a5f;
    selection-color: #4d9bff;
    alternate-background-color: #2a2f38;
    outline: none;
}
QTableView::item, QTableWidget::item {
    padding: 6px 8px;
}
QTableView::item:hover, QTableWidget::item:hover {
    background-color: #2a3a52;
}
QTableView::item:selected, QTableWidget::item:selected {
    background-color: #1e3a5f;
    color: #4d9bff;
}

QHeaderView::section {
    background-color: #2a2f38;
    color: #a0a8b8;
    border: none;
    border-bottom: 1px solid #3a4050;
    border-right: 1px solid #3a4050;
    padding: 8px 10px;
    font-weight: 600;
}

/* 滚动条（深色） */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #4a5260;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #2b7bff;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #4a5260;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #2b7bff;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip {
    background-color: #2a3040;
    color: #e8ecf0;
    border: 1px solid #3a4050;
    border-radius: 4px;
    padding: 4px 8px;
}

QMenu {
    background-color: #2a3040;
    color: #e8ecf0;
    border: 1px solid #3a4050;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #1e3a5f;
    color: #4d9bff;
}

QCheckBox {
    color: #e8ecf0;
    spacing: 6px;
}

QGroupBox {
    background-color: #252a33;
    border: 1px solid #3a4050;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #a0a8b8;
}
